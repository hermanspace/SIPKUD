# Dependencies (reinstalled in build)
/node_modules
/vendor

# Git and IDE
/.git
/.gitignore
/.gitattributes
/.cursor
/.idea
/.vscode
*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example

# Build and cache
/public/hot
/public/storage
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
!/bootstrap/cache/.gitignore

# Testing and docs
/tests
/phpunit.xml
.phpunit.result.cache
/docs
*.md
!README.md

# Docker
/Dockerfile*
/docker-compose*
/.dockerignore

# Misc
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
